{
  "name": "markdown-ai-mcp",
  "description": "> **By [MEOK AI Labs](https://meok.ai)** \u2014 MEOK AI Labs MCP Server",
  "version": "1.0.0",
  "tools": [
    {
      "name": "convert_to_html",
      "description": "Convert Markdown to HTML (supports headers, bold, italic, links, code, lists).",
      "parameters": {
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "markdown"
        ]
      }
    },
    {
      "name": "generate_toc",
      "description": "Generate a table of contents from Markdown headers.",
      "parameters": {
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string"
          },
          "max_depth": {
            "type": "integer"
          }
        },
        "required": [
          "markdown"
        ]
      }
    },
    {
      "name": "lint_markdown",
      "description": "Lint Markdown for common issues.",
      "parameters": {
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "markdown"
        ]
      }
    },
    {
      "name": "format_table",
      "description": "Format data as a Markdown table. headers: comma-separated. rows: semicolon-separated rows of comma-separated values. alignment: L/C/R per column.",
      "parameters": {
        "type": "object",
        "properties": {
          "headers": {
            "type": "string"
          },
          "rows": {
            "type": "string"
          },
          "alignment": {
            "type": "string"
          }
        },
        "required": [
          "headers",
          "rows"
        ]
      }
    }
  ]
}